---
import { services } from '~/data/hub';

const statusText = {
  online: '正常',
  warning: '注意',
  offline: '离线',
  planned: '计划中',
};
---

<section class="space-y-6">
  <div>
    <p class="text-sm font-semibold uppercase tracking-[0.28em] text-cyan-600 dark:text-cyan-300">Health</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white">状态详情</h2>
    <p class="mt-3 text-slate-600 dark:text-slate-300">当前是静态状态面板。后续可以接入 Dev Orchestrator 健康检查、Docker 状态和部署状态。</p>
  </div>

  <div class="grid gap-5 lg:grid-cols-3">
    {
      services.map((service) => (
        <article id={service.href.split('#')[1]} class="scroll-mt-28 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-lg font-bold text-slate-950 dark:text-white">{service.title}</h3>
            <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300">
              {statusText[service.status ?? 'planned']}
            </span>
          </div>
          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">{service.description}</p>
          <dl class="mt-5 space-y-3 text-sm">
            <div class="flex justify-between gap-4 border-t border-slate-100 pt-3 dark:border-slate-800">
              <dt class="text-slate-500 dark:text-slate-400">检查方式</dt>
              <dd class="font-medium text-slate-800 dark:text-slate-100">静态占位</dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-slate-100 pt-3 dark:border-slate-800">
              <dt class="text-slate-500 dark:text-slate-400">后续计划</dt>
              <dd class="font-medium text-slate-800 dark:text-slate-100">接入 API</dd>
            </div>
          </dl>
        </article>
      ))
    }
  </div>
</section>
