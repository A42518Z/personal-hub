---
import { projects } from '~/data/hub';
---

<section class="space-y-6">
  <div>
    <p class="text-sm font-semibold uppercase tracking-[0.28em] text-cyan-600 dark:text-cyan-300">Showcase</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white">项目详情</h2>
    <p class="mt-3 text-slate-600 dark:text-slate-300">这里先做作品集式详情卡，后续可以继续补截图、仓库、线上地址和复盘链接。</p>
  </div>

  <div class="space-y-5">
    {
      projects.map((project, index) => (
        <article class="grid gap-5 rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 lg:grid-cols-[0.8fr_1.2fr]">
          <div class="grid min-h-56 place-items-center rounded-3xl bg-slate-950 p-6 text-white">
            <div class="text-center">
              <div class="mx-auto grid size-16 place-items-center rounded-3xl bg-white/10 text-2xl font-bold">{index + 1}</div>
              <p class="mt-4 text-sm uppercase tracking-[0.3em] text-cyan-200">{project.badge ?? 'Project'}</p>
            </div>
          </div>
          <div class="flex flex-col justify-center p-2 lg:p-6">
            <h3 class="text-2xl font-bold text-slate-950 dark:text-white">{project.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">{project.description}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              <span class="rounded-full bg-cyan-50 px-3 py-1 text-xs font-medium text-cyan-700 dark:bg-cyan-500/10 dark:text-cyan-300">规划中</span>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">截图待补</span>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">复盘待补</span>
            </div>
            <a href={project.href} class="mt-6 inline-flex w-fit rounded-full bg-slate-950 px-5 py-2 text-sm font-semibold text-white dark:bg-white dark:text-slate-950">查看入口</a>
          </div>
        </article>
      ))
    }
  </div>
</section>
