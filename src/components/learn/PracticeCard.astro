---
import type { PracticeQuestion } from '~/data/learn/java-basic';

const { question, index } = Astro.props as { question: PracticeQuestion; index: number };
---

<article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
  <div class="flex flex-wrap items-center gap-3">
    <span class="rounded-full bg-cyan-50 px-3 py-1 text-xs font-semibold text-cyan-700 dark:bg-cyan-500/10 dark:text-cyan-300">第 {index + 1} 题</span>
    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">{question.chapter}</span>
    <span class="rounded-full bg-violet-50 px-3 py-1 text-xs font-medium text-violet-700 dark:bg-violet-500/10 dark:text-violet-300">{question.type}</span>
  </div>

  <h2 class="mt-4 text-xl font-semibold text-slate-950 dark:text-white">{question.title}</h2>
  <p class="mt-3 text-sm leading-7 text-slate-700 dark:text-slate-300">{question.question}</p>

  {question.code && (
    <pre class="mt-4 overflow-x-auto rounded-2xl bg-slate-950 p-4 text-sm leading-7 text-slate-100"><code>{question.code}</code></pre>
  )}

  <div class="mt-5 rounded-2xl border border-cyan-100 bg-cyan-50 p-5 dark:border-cyan-500/20 dark:bg-cyan-500/10">
    <h3 class="text-sm font-semibold text-cyan-800 dark:text-cyan-200">按这几步自己说出来</h3>
    <ol class="mt-3 space-y-2 text-sm leading-7 text-slate-700 dark:text-slate-300">
      {question.guideSteps.map((step, stepIndex) => (
        <li class="flex gap-3">
          <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-white text-xs font-bold text-cyan-700 dark:bg-slate-950 dark:text-cyan-300">{stepIndex + 1}</span>
          <span>{step}</span>
        </li>
      ))}
    </ol>
  </div>

  <label class="mt-5 block">
    <span class="text-sm font-semibold text-slate-950 dark:text-white">先用自己的话写一版</span>
    <textarea
      class="mt-3 min-h-36 w-full rounded-2xl border border-slate-200 bg-white p-4 text-sm leading-7 text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-cyan-400 focus:ring-4 focus:ring-cyan-100 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:focus:border-cyan-500 dark:focus:ring-cyan-500/10"
      placeholder="不要追求和参考答案一样。先写：我的结论是……原因是……举个例子……容易错的点是……"
    ></textarea>
  </label>

  <details class="mt-5 rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/70">
    <summary class="cursor-pointer text-sm font-semibold text-violet-700 dark:text-violet-300">展开自检清单</summary>
    <ul class="mt-4 space-y-2 text-sm leading-7 text-slate-700 dark:text-slate-300">
      {question.checklist.map((item) => <li class="flex gap-2"><span class="text-violet-500">□</span><span>{item}</span></li>)}
    </ul>
  </details>

  <details class="mt-3 rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/70">
    <summary class="cursor-pointer text-sm font-semibold text-cyan-700 dark:text-cyan-300">最后再看参考表达</summary>
    <div class="mt-4 space-y-3 text-sm leading-7 text-slate-700 dark:text-slate-300">
      <p><strong class="text-slate-950 dark:text-white">参考表达：</strong>{question.referenceAnswer}</p>
      {question.commonMistake && <p><strong class="text-slate-950 dark:text-white">常见误区：</strong>{question.commonMistake}</p>}
    </div>
  </details>
</article>
