---
---

<article id="regex" class="scroll-mt-28 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h3 class="text-xl font-bold text-slate-950 dark:text-white">正则测试</h3>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">输入表达式和测试文本，查看匹配结果、分组和索引。</p>
    </div>
    <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300">ready</span>
  </div>

  <div class="mt-5 grid gap-4 lg:grid-cols-[1fr_auto]">
    <label class="block">
      <span class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200">表达式</span>
      <input id="regex-pattern" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm text-slate-900 outline-none focus:border-cyan-400 focus:ring-4 focus:ring-cyan-100 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:focus:ring-cyan-500/10" value="personal|hub" placeholder="例如 personal|hub" />
    </label>
    <label class="block min-w-48">
      <span class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200">Flags</span>
      <input id="regex-flags" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm text-slate-900 outline-none focus:border-cyan-400 focus:ring-4 focus:ring-cyan-100 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:focus:ring-cyan-500/10" value="gi" placeholder="gimuy" />
    </label>
  </div>

  <label class="mt-4 block">
    <span class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200">测试文本</span>
    <textarea id="regex-text" class="min-h-40 w-full rounded-2xl border border-slate-200 bg-slate-50 p-4 font-mono text-sm text-slate-900 outline-none focus:border-cyan-400 focus:ring-4 focus:ring-cyan-100 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:focus:ring-cyan-500/10">Personal Hub 是一个 personal website，也是一组 hub tools。</textarea>
  </label>

  <div class="mt-4 flex flex-wrap gap-3">
    <button id="regex-run" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white dark:bg-white dark:text-slate-950" type="button">运行匹配</button>
    <button id="regex-clear" class="rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200" type="button">清空结果</button>
  </div>

  <div class="mt-5 rounded-2xl bg-slate-50 p-4 dark:bg-slate-950">
    <div class="mb-3 text-sm font-semibold text-slate-700 dark:text-slate-200">匹配结果</div>
    <ol id="regex-results" class="space-y-2 text-sm text-slate-700 dark:text-slate-200"></ol>
  </div>

  <p id="regex-message" class="mt-4 text-sm text-slate-500 dark:text-slate-400" aria-live="polite"></p>
</article>

<script is:inline>
  const initRegexTester = () => {
    const root = document.querySelector('#regex');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const patternInput = root.querySelector('#regex-pattern');
    const flagsInput = root.querySelector('#regex-flags');
    const textInput = root.querySelector('#regex-text');
    const results = root.querySelector('#regex-results');
    const message = root.querySelector('#regex-message');

    const setMessage = (text, isError = false) => {
      if (!message) return;
      message.textContent = text;
      message.classList.toggle('text-rose-600', isError);
      message.classList.toggle('dark:text-rose-300', isError);
    };

    const run = () => {
      if (!patternInput || !flagsInput || !textInput || !results) return;
      results.innerHTML = '';

      try {
        const flags = flagsInput.value.includes('g') ? flagsInput.value : `${flagsInput.value}g`;
        const regex = new RegExp(patternInput.value, flags);
        const matches = Array.from(textInput.value.matchAll(regex));

        matches.forEach((match) => {
          const item = document.createElement('li');
          item.className = 'rounded-xl border border-slate-200 bg-white p-3 font-mono dark:border-slate-800 dark:bg-slate-900';
          const groups = match.slice(1).filter(Boolean);
          item.textContent = `匹配：${match[0]} | index: ${match.index ?? 0}${groups.length ? ` | groups: ${groups.join(', ')}` : ''}`;
          results.append(item);
        });

        setMessage(matches.length ? `找到 ${matches.length} 个匹配。` : '没有找到匹配。');
      } catch (error) {
        const detail = error instanceof Error ? error.message : '未知错误';
        setMessage(`正则错误：${detail}`, true);
      }
    };

    root.querySelector('#regex-run')?.addEventListener('click', run);
    root.querySelector('#regex-clear')?.addEventListener('click', () => {
      if (results) results.innerHTML = '';
      setMessage('结果已清空。');
    });

    run();
  };

  initRegexTester();
  document.addEventListener('astro:page-load', initRegexTester);
</script>
