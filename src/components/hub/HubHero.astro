---
const { title, eyebrow, description } = Astro.props;
---

<section class="relative overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-950 px-6 py-16 text-white shadow-2xl shadow-slate-200/70 dark:border-slate-800 dark:shadow-none sm:px-10">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(56,189,248,0.35),_transparent_32%),radial-gradient(circle_at_bottom_right,_rgba(168,85,247,0.28),_transparent_36%)]"></div>
  <div class="relative max-w-3xl">
    <p class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-cyan-200">{eyebrow}</p>
    <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">{title}</h1>
    <p class="mt-6 text-lg leading-8 text-slate-200">{description}</p>
  </div>
</section>
