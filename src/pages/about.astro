---
import Layout from '~/layouts/PageLayout.astro';
import HubHero from '~/components/hub/HubHero.astro';
import Reveal from '~/components/effects/Reveal.astro';
import { principles, profile, profileStats, skills, timeline } from '~/data/profile';

const metadata = {
  title: '关于',
  description: profile.summary,
};
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-7xl space-y-14 px-4 py-10 sm:px-6 lg:px-8">
    <Reveal>
      <HubHero eyebrow="About" title={profile.role} description={profile.summary} />
    </Reveal>

    <Reveal delay={80}>
      <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          profileStats.map((item) => (
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
              <div class="text-3xl font-bold text-slate-950 dark:text-white">{item.value}</div>
              <div class="mt-2 text-sm text-slate-500 dark:text-slate-400">{item.label}</div>
            </div>
          ))
        }
      </section>
    </Reveal>

    <Reveal delay={120}>
      <section class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.28em] text-cyan-600 dark:text-cyan-300">Timeline</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white">构建过程</h2>
          <p class="mt-4 text-slate-600 dark:text-slate-300">这个站点会持续演化，每一步都尽量保持结构清晰、可回退、可扩展。</p>
        </div>

        <div class="space-y-4">
          {
            timeline.map((item, index) => (
              <div class="relative rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
                <div class="mb-3 inline-flex size-9 items-center justify-center rounded-2xl bg-slate-950 text-sm font-bold text-white dark:bg-white dark:text-slate-950">
                  {index + 1}
                </div>
                <h3 class="text-lg font-semibold text-slate-950 dark:text-white">{item.title}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{item.description}</p>
              </div>
            ))
          }
        </div>
      </section>
    </Reveal>

    <Reveal delay={160}>
      <section class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-8">
        <div class="mb-6">
          <p class="text-sm font-semibold uppercase tracking-[0.28em] text-cyan-600 dark:text-cyan-300">Skills</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white">当前关注的能力栈</h2>
        </div>
        <div class="flex flex-wrap gap-3">
          {skills.map((item) => <span class="rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">{item}</span>)}
        </div>
      </section>
    </Reveal>

    <Reveal delay={200}>
      <section class="space-y-5">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.28em] text-cyan-600 dark:text-cyan-300">Principles</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white">维护原则</h2>
        </div>
        <div class="grid gap-5 md:grid-cols-2">
          {
            principles.map((item) => (
              <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
                <h3 class="text-lg font-semibold text-slate-950 dark:text-white">{item.title}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{item.description}</p>
              </div>
            ))
          }
        </div>
      </section>
    </Reveal>
  </div>
</Layout>
