---
import Layout from '~/layouts/PageLayout.astro';
import HubHero from '~/components/hub/HubHero.astro';
import GroupSection from '~/components/hub/GroupSection.astro';
import Reveal from '~/components/effects/Reveal.astro';
import ToolPreviewGrid from '~/components/tools/ToolPreviewGrid.astro';
import { tools } from '~/data/hub';

const metadata = {
  title: '工具箱',
  description: 'Personal Hub 的开发工具箱，包含 JSON、Base64、Markdown、时间戳和正则等工具入口。',
};
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-7xl space-y-12 px-4 py-10 sm:px-6 lg:px-8">
    <Reveal>
      <HubHero
        eyebrow="Toolbox"
        title="常用开发小工具集中放置。"
        description="点击工具卡片会跳到对应详情模块。第一版先补齐清晰落点，后续逐个接入真实交互。"
      />
    </Reveal>

    <Reveal delay={80}>
      <div class="space-y-10">
        {tools.map((group) => <GroupSection group={group} />)}
      </div>
    </Reveal>

    <Reveal delay={140}>
      <ToolPreviewGrid />
    </Reveal>
  </div>
</Layout>
