---
import Layout from '~/layouts/PageLayout.astro';
import HubHero from '~/components/hub/HubHero.astro';
import Reveal from '~/components/effects/Reveal.astro';
import NesPlayer from '~/components/games/NesPlayer.astro';
import { games, getGameBySlug } from '~/data/games';

export function getStaticPaths() {
  return [{ params: { slug: 'local-rom' } }, ...games.map((game) => ({ params: { slug: game.slug } }))];
}

const slug = Astro.params.slug || 'local-rom';
const game = slug === 'local-rom' ? undefined : getGameBySlug(slug);
const isLocalRom = slug === 'local-rom';

const metadata = {
  title: isLocalRom ? '本地 ROM 播放器' : game?.title || '童年游戏',
  description: isLocalRom ? '上传合法 NES ROM，在浏览器端使用 Canvas 和 Web Audio 运行。' : game?.description,
};
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-7xl space-y-12 px-4 py-10 sm:px-6 lg:px-8">
    <Reveal>
      <HubHero
        eyebrow={isLocalRom ? 'NES Emulator' : `NES · ${game?.sourceIndex}`}
        title={isLocalRom ? '上传本地 ROM，直接开玩。' : `${game?.title}，启动！`}
        description={isLocalRom ? '播放器基于 jsnes 在浏览器端运行，画面通过 Canvas 渲染，音频通过 Web Audio 输出。ROM 文件只在本地读取。' : game?.description || ''}
      />
    </Reveal>

    {
      game && (
        <Reveal delay={60}>
          <div class="flex flex-wrap gap-2">
            {game.tags.map((tag) => <span class="rounded-full bg-cyan-50 px-3 py-1 text-sm font-medium text-cyan-700 dark:bg-cyan-500/10 dark:text-cyan-300">{tag}</span>)}
          </div>
        </Reveal>
      )
    }

    <Reveal delay={80}>
      <NesPlayer title={isLocalRom ? '本地 ROM 播放器' : game?.title} romUrl={game?.romUrl} description={game?.description} />
    </Reveal>
  </div>
</Layout>
