---
import Layout from '~/layouts/PageLayout.astro';
import HubHero from '~/components/hub/HubHero.astro';
import Reveal from '~/components/effects/Reveal.astro';
import { happyHourImages, happyHourCategories, happyHourMoods } from '~/data/happyHour';

const metadata = {
  title: '欢乐时光',
  description: '收藏那些让人会心一笑的搞笑图片、表情包和生活梗图。',
};

const imagesJson = JSON.stringify(happyHourImages);
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-7xl space-y-10 px-4 py-10 sm:px-6 lg:px-8">
    <Reveal>
      <HubHero
        eyebrow="Happy Hour"
        title="把快乐库存翻出来晒晒。"
        description={`这里先展示 ${happyHourImages.length} 张搞笑图片。以后图片很多时，可以迁移到 CDN，页面结构不用重做。`}
      />
    </Reveal>

    <Reveal delay={80}>
      <section class="grid gap-5 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="overflow-hidden rounded-[2rem] border border-pink-200 bg-pink-50 p-6 shadow-sm dark:border-pink-500/20 dark:bg-pink-500/10">
          <p class="text-sm font-semibold uppercase tracking-[0.28em] text-pink-700 dark:text-pink-300">Mood Board</p>
          <h2 class="mt-3 text-2xl font-bold text-slate-950 dark:text-white">低气压撤退区</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">
            先用本地图片做效果预览：瀑布流、分类、搜索、随机一笑。后续只要把图片路径切到 CDN 即可。
          </p>
        </div>

        <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <p class="text-sm font-semibold uppercase tracking-[0.28em] text-amber-600 dark:text-amber-300">Storage</p>
          <h2 class="mt-3 text-2xl font-bold text-slate-950 dark:text-white">当前：本地静态资源</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">
            图片先放在 public/happy-hour/。未来配置 PUBLIC_HAPPY_HOUR_CDN_URL 后，可以统一切换到 CDN。
          </p>
        </div>
      </section>
    </Reveal>

    <Reveal delay={120}>
      <section class="space-y-6" data-happy-hour>
        <script type="application/json" data-happy-hour-json set:html={imagesJson}></script>

        <div class="grid gap-4 rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 lg:grid-cols-[minmax(0,1fr)_180px_180px_auto]">
          <label class="space-y-2">
            <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">搜索快乐</span>
            <input data-happy-search type="search" placeholder="输入标题、描述或标签" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-pink-400 focus:ring-4 focus:ring-pink-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:ring-pink-500/10" />
          </label>

          <label class="space-y-2">
            <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">分类</span>
            <select data-happy-category class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-pink-400 focus:ring-4 focus:ring-pink-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:ring-pink-500/10">
              <option value="">全部分类</option>
              {happyHourCategories.map((category) => <option value={category}>{category}</option>)}
            </select>
          </label>

          <label class="space-y-2">
            <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">心情</span>
            <select data-happy-mood class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-pink-400 focus:ring-4 focus:ring-pink-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:ring-pink-500/10">
              <option value="">全部心情</option>
              {happyHourMoods.map((mood) => <option value={mood}>{mood}</option>)}
            </select>
          </label>

          <div class="flex items-end">
            <button data-random-happy type="button" class="w-full rounded-2xl bg-pink-500 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-pink-200 transition hover:-translate-y-0.5 hover:bg-pink-600 dark:shadow-none">
              随机一笑
            </button>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-sm text-slate-600 dark:text-slate-300">当前有 <span data-happy-count>{happyHourImages.length}</span> 张快乐库存</p>
          <p class="text-xs text-slate-400 dark:text-slate-500">支持 jpg / png / webp / gif / svg，本地与 CDN 图片都可以。</p>
        </div>

        <div data-happy-grid class="columns-1 gap-5 sm:columns-2 lg:columns-3"></div>

        <p data-happy-empty class="hidden rounded-3xl border border-dashed border-slate-300 p-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
          暂时没有找到这份快乐。
        </p>
      </section>
    </Reveal>
  </div>
</Layout>

<script>
  type HappyHourImage = {
    title: string;
    src: string;
    category: string;
    description?: string;
    tags?: string[];
    mood?: string;
  };

  const dataScript = document.querySelector<HTMLScriptElement>('[data-happy-hour-json]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-happy-search]');
  const categorySelect = document.querySelector<HTMLSelectElement>('[data-happy-category]');
  const moodSelect = document.querySelector<HTMLSelectElement>('[data-happy-mood]');
  const grid = document.querySelector<HTMLElement>('[data-happy-grid]');
  const countLabel = document.querySelector<HTMLElement>('[data-happy-count]');
  const emptyState = document.querySelector<HTMLElement>('[data-happy-empty]');
  const randomButton = document.querySelector<HTMLButtonElement>('[data-random-happy]');

  const allImages: HappyHourImage[] = dataScript?.textContent ? JSON.parse(dataScript.textContent) : [];

  function normalize(value: string) {
    return value.trim().toLowerCase();
  }

  function escapeHtml(value: string) {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function getFilteredImages() {
    const keyword = normalize(searchInput?.value || '');
    const category = categorySelect?.value || '';
    const mood = moodSelect?.value || '';

    return allImages.filter((item) => {
      const haystack = normalize(`${item.title} ${item.description || ''} ${(item.tags || []).join('|')} ${item.mood || ''}`);
      return (!keyword || haystack.includes(keyword)) && (!category || item.category === category) && (!mood || item.mood === mood);
    });
  }

  function renderCard(item: HappyHourImage, index: number) {
    const tags = (item.tags || [])
      .map((tag) => `<span class="rounded-full bg-pink-50 px-2.5 py-1 text-xs text-pink-700 dark:bg-pink-500/10 dark:text-pink-200">${escapeHtml(tag)}</span>`)
      .join('');

    return `
      <article id="happy-${index}" class="mb-5 break-inside-avoid overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl hover:shadow-pink-100/70 dark:border-slate-800 dark:bg-slate-900 dark:hover:shadow-none">
        <img src="${escapeHtml(item.src)}" alt="${escapeHtml(item.title)}" loading="lazy" class="w-full bg-slate-100 object-cover dark:bg-slate-800" />
        <div class="space-y-3 p-5">
          <div class="flex items-start justify-between gap-3">
            <h2 class="text-lg font-bold text-slate-950 dark:text-white">${escapeHtml(item.title)}</h2>
            <span class="shrink-0 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300">${escapeHtml(item.category)}</span>
          </div>
          ${item.description ? `<p class="text-sm leading-6 text-slate-600 dark:text-slate-300">${escapeHtml(item.description)}</p>` : ''}
          <div class="flex flex-wrap gap-2">${tags}</div>
        </div>
      </article>
    `;
  }

  function render() {
    const filtered = getFilteredImages();
    if (grid) grid.innerHTML = filtered.map(renderCard).join('');
    if (countLabel) countLabel.textContent = String(filtered.length);
    emptyState?.classList.toggle('hidden', filtered.length > 0);
  }

  searchInput?.addEventListener('input', render);
  categorySelect?.addEventListener('change', render);
  moodSelect?.addEventListener('change', render);

  randomButton?.addEventListener('click', () => {
    const filtered = getFilteredImages();
    if (!filtered.length) return;
    const index = Math.floor(Math.random() * filtered.length);
    document.querySelector(`#happy-${index}`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  render();
</script>
