---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'WebRTC 摄像头拍照实验',
  description: '调用浏览器摄像头预览画面，并把当前视频帧拍成图片。',
};
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-6xl space-y-8 px-4 py-10 sm:px-6 lg:px-8">
    <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="grid gap-8 p-6 lg:grid-cols-[1.1fr_0.9fr] lg:p-8">
        <div class="space-y-5">
          <a href="/lab" class="text-sm font-semibold text-cyan-700 hover:text-cyan-600 dark:text-cyan-300">← 返回实验室</a>
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.28em] text-cyan-600 dark:text-cyan-300">WebRTC</p>
            <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl">摄像头拍照</h1>
            <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-300">
              使用 <code>navigator.mediaDevices.getUserMedia</code> 获取摄像头画面，再通过 Canvas 把当前视频帧导出成 PNG 图片。
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <button id="startCamera" class="rounded-full bg-cyan-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-cyan-500">开启摄像头</button>
            <button id="takePhoto" disabled class="rounded-full bg-slate-950 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-45 dark:bg-white dark:text-slate-950">拍照</button>
            <button id="stopCamera" disabled class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-45 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">关闭摄像头</button>
          </div>
          <p id="cameraStatus" class="rounded-2xl bg-slate-100 px-4 py-3 text-sm text-slate-700 dark:bg-slate-800 dark:text-slate-200">请点击“开启摄像头”，并允许浏览器访问摄像头。</p>
        </div>

        <div class="rounded-[1.5rem] border border-slate-200 bg-slate-950 p-3 dark:border-slate-700">
          <video id="cameraPreview" class="aspect-video w-full rounded-[1.1rem] bg-slate-900 object-cover" autoplay playsinline muted></video>
        </div>
      </div>
    </section>

    <section class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-xl font-bold text-slate-950 dark:text-white">拍照结果</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">照片只在本地浏览器中生成，不会上传到服务器。</p>
        <a id="downloadPhoto" class="mt-5 inline-flex cursor-not-allowed rounded-full bg-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-500 dark:bg-slate-800 dark:text-slate-400">下载照片</a>
      </div>

      <figure class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <canvas id="photoCanvas" class="hidden"></canvas>
        <img id="photoOutput" alt="拍照结果预览" class="aspect-video w-full bg-slate-100 object-contain dark:bg-slate-950" />
      </figure>
    </section>
  </div>
</Layout>

<script>
  const video = document.querySelector('#cameraPreview');
  const canvas = document.querySelector('#photoCanvas');
  const output = document.querySelector('#photoOutput');
  const startButton = document.querySelector('#startCamera');
  const takeButton = document.querySelector('#takePhoto');
  const stopButton = document.querySelector('#stopCamera');
  const status = document.querySelector('#cameraStatus');
  const download = document.querySelector('#downloadPhoto');

  let stream;

  const setStatus = (message) => {
    status.textContent = message;
  };

  const setCameraEnabled = (enabled) => {
    takeButton.disabled = !enabled;
    stopButton.disabled = !enabled;
    startButton.disabled = enabled;
  };

  const stopCamera = () => {
    if (stream) {
      stream.getTracks().forEach((track) => track.stop());
      stream = undefined;
    }
    video.srcObject = null;
    setCameraEnabled(false);
    setStatus('摄像头已关闭。');
  };

  startButton.addEventListener('click', async () => {
    if (!navigator.mediaDevices?.getUserMedia) {
      setStatus('当前浏览器不支持 getUserMedia，请使用最新版 Chrome、Edge、Firefox 或 Safari。');
      return;
    }

    try {
      stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
      video.srcObject = stream;
      setCameraEnabled(true);
      setStatus('摄像头已开启，可以点击“拍照”截取当前画面。');
    } catch (error) {
      setStatus(`摄像头开启失败：${error instanceof Error ? error.message : '请检查权限或设备占用状态。'}`);
    }
  });

  takeButton.addEventListener('click', () => {
    if (!stream || !video.videoWidth) {
      setStatus('视频画面还没有准备好，请稍后再拍。');
      return;
    }

    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    const context = canvas.getContext('2d');
    context.drawImage(video, 0, 0, canvas.width, canvas.height);
    const dataUrl = canvas.toDataURL('image/png');
    output.src = dataUrl;
    download.href = dataUrl;
    download.download = `webrtc-photo-${Date.now()}.png`;
    download.className = 'mt-5 inline-flex rounded-full bg-cyan-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-cyan-500';
    setStatus('照片已生成，可预览或下载。');
  });

  stopButton.addEventListener('click', stopCamera);
  window.addEventListener('pagehide', stopCamera);
</script>
