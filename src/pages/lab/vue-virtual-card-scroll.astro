---
import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Vue 卡片虚拟分页实验 · 前端实验室',
  description: '从 Vue 虚拟卡片滚动 demo 迁入的前端实验：大页数卡片虚拟滚动、分页跳转、缓存窗口与模拟请求。',
};
---

<PageLayout metadata={metadata}>
  <section class="lab-virtual-card" data-virtual-card-lab>
    <header class="lab-hero">
      <div>
        <p class="eyebrow">Frontend Lab · Virtual Paging</p>
        <h1>Vue 卡片虚拟分页实验</h1>
        <p class="subtitle">
          从独立 Vue demo 迁入前端实验室：用固定页高模拟超长列表，只渲染可视页附近卡片，并在停稳后加载当前页缓存。
        </p>
      </div>
      <div class="button-row">
        <button type="button" data-jump="1">第一页</button>
        <button type="button" data-jump="500">跳到 500</button>
        <button type="button" data-jump-last>最后一页</button>
      </div>
    </header>

    <section class="control-bar" aria-label="虚拟分页控制台">
      <label class="control">
        <span>拖动分页</span>
        <input data-range-page type="range" min="1" max="1000" value="1" />
      </label>
      <label class="control">
        <span>总页数</span>
        <input data-total-pages type="number" min="1" max="100000" value="1000" />
      </label>
      <label class="control">
        <span>跳转页</span>
        <input data-jump-page type="number" min="1" max="1000" value="800" />
      </label>
      <div class="button-row compact">
        <button type="button" class="primary" data-apply-total>应用页数</button>
        <button type="button" data-jump-input>跳转</button>
        <button type="button" data-clear-cache>清缓存</button>
        <button type="button" data-nudge="-1">上一页</button>
        <button type="button" data-nudge="1">下一页</button>
      </div>
    </section>

    <section class="live-strip" aria-live="polite">
      <div class="live-title">
        <span>当前页</span>
        <strong data-current-page>1</strong>
        <span data-total-label>/ 1,000 页</span>
      </div>
      <span class="status-pill" data-drag-status>停稳</span>
      <span class="status-pill optimized" data-load-policy>加载第 1 页附近</span>
      <span class="status-pill" data-wheel-status>滚轮按速度跳页</span>
    </section>

    <section class="main-grid">
      <section class="viewer" aria-label="虚拟卡片视窗">
        <div class="viewer-head">
          <strong>虚拟视窗</strong>
          <span data-range-label>卡片 1 - 6 · 进度 0.00%</span>
        </div>
        <div class="viewport-wrap">
          <div class="scroll-hud" data-hud>正在浏览 <strong>第 1 页</strong></div>
          <div class="viewport" data-viewport>
            <div class="spacer" data-spacer></div>
            <div data-pages></div>
          </div>
        </div>
      </section>

      <aside class="side" aria-label="缓存状态">
        <div class="metric-grid">
          <div class="metric">
            <span class="metric-label">总卡片数</span>
            <strong class="metric-value" data-total-cards>6,000</strong>
          </div>
          <div class="metric">
            <span class="metric-label">已缓存页</span>
            <div class="chip-list" data-cached-pages></div>
          </div>
          <div class="metric">
            <span class="metric-label">请求中</span>
            <div class="chip-list" data-pending-pages></div>
          </div>
          <div class="metric">
            <span class="metric-label">最近请求</span>
            <strong class="metric-value small" data-last-request>等待首次加载</strong>
          </div>
          <p class="notice" data-notice></p>
        </div>
      </aside>
    </section>
  </section>
</PageLayout>

<style>
  .lab-virtual-card {
    --bg: #f4f7fb;
    --surface: #ffffff;
    --surface-soft: #eef4f8;
    --viewport-bg: #ffffff;
    --page-bg: #f8fbff;
    --surface-card: #ffffff;
    --field-bg: #ffffff;
    --ink: #172033;
    --muted: #66758a;
    --line: #d8e0ea;
    --line-strong: #b8c4d2;
    --accent: #0f766e;
    --accent-strong: #0a5f59;
    --violet: #6656d9;
    --amber: #b7791f;
    --red: #b42318;
    --button-hover: #f2fbfa;
    --success-soft: #e9f7f5;
    --violet-soft: #f0eefe;
    --amber-soft: #fff4dc;
    --hud-bg: rgba(255, 255, 255, 0.94);
    --panel-shadow: rgba(23, 32, 51, 0.06);
    --soft-shadow: rgba(23, 32, 51, 0.05);
    --hud-shadow: rgba(23, 32, 51, 0.12);
    --skeleton-a: #edf1f6;
    --skeleton-b: #dfe7f1;
    --primary-contrast: #ffffff;
    --radius: 12px;
    width: min(1180px, calc(100vw - 32px));
    margin: 0 auto;
    padding: 32px 0 44px;
    color: var(--ink);
  }

  :global(.dark) .lab-virtual-card {
    --bg: #020617;
    --surface: #0f172a;
    --surface-soft: #111c31;
    --viewport-bg: #0b1120;
    --page-bg: #172033;
    --surface-card: #243247;
    --field-bg: #020617;
    --ink: #e5eefb;
    --muted: #94a3b8;
    --line: #3f5068;
    --line-strong: #64748b;
    --accent: #2dd4bf;
    --accent-strong: #5eead4;
    --violet: #a78bfa;
    --amber: #fbbf24;
    --red: #f87171;
    --button-hover: rgba(45, 212, 191, 0.12);
    --success-soft: rgba(45, 212, 191, 0.14);
    --violet-soft: rgba(167, 139, 250, 0.14);
    --amber-soft: rgba(251, 191, 36, 0.14);
    --hud-bg: rgba(15, 23, 42, 0.92);
    --panel-shadow: rgba(0, 0, 0, 0.32);
    --soft-shadow: rgba(0, 0, 0, 0.24);
    --hud-shadow: rgba(0, 0, 0, 0.36);
    --skeleton-a: #1e293b;
    --skeleton-b: #334155;
    --primary-contrast: #031b1a;
  }
  .lab-hero { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 14px; }
  .eyebrow { margin: 0 0 8px; color: var(--accent-strong); font-size: 13px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .lab-hero h1 { margin: 0; font-size: clamp(28px, 4vw, 44px); line-height: 1.08; }
  .subtitle { margin: 10px 0 0; max-width: 760px; color: var(--muted); font-size: 15px; line-height: 1.7; }
  .button-row { display: flex; flex-wrap: wrap; gap: 8px; }
  button { height: 36px; border: 1px solid var(--line-strong); border-radius: 8px; padding: 0 12px; color: var(--ink); background: var(--field-bg); cursor: pointer; transition: border-color 140ms ease, background 140ms ease, transform 140ms ease; }
  button:hover { border-color: var(--accent); background: var(--button-hover); }
  button:active { transform: translateY(1px); }
  button.primary { border-color: var(--accent); color: var(--primary-contrast); background: var(--accent); }
  button.primary:hover { border-color: var(--accent-strong); background: var(--accent-strong); }
  .control-bar, .live-strip { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); box-shadow: 0 12px 30px var(--soft-shadow); }
  .control-bar { display: grid; grid-template-columns: minmax(220px, 1fr) 140px 140px auto; gap: 12px; align-items: end; padding: 12px; margin-bottom: 12px; }
  .control { display: grid; gap: 7px; }
  .control span { color: var(--muted); font-size: 12px; line-height: 1; }
  input[type='number'] { width: 100%; height: 36px; border: 1px solid var(--line-strong); border-radius: 8px; padding: 0 10px; color: var(--ink); background: var(--field-bg); outline: none; }
  input[type='number']:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.16); }
  input[type='range'] { width: 100%; accent-color: var(--accent); }
  .compact { justify-content: flex-end; }
  .live-strip { display: grid; grid-template-columns: 1fr auto auto auto; gap: 14px; align-items: center; padding: 12px 14px; margin-bottom: 12px; }
  .live-title { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: baseline; min-width: 0; }
  .live-title span { color: var(--muted); font-size: 13px; }
  .live-title strong { color: var(--accent-strong); font-size: clamp(28px, 5vw, 44px); line-height: 1; font-variant-numeric: tabular-nums; }
  .status-pill { display: inline-flex; align-items: center; min-height: 28px; border-radius: 999px; padding: 5px 10px; color: var(--muted); background: var(--surface-soft); font-size: 12px; font-weight: 700; white-space: nowrap; }
  .status-pill.active { color: var(--primary-contrast); background: var(--violet); }
  .status-pill.optimized { color: var(--accent-strong); background: var(--success-soft); }
  .main-grid { display: grid; grid-template-columns: minmax(0, 1fr) 292px; gap: 14px; align-items: start; }
  .viewer, .side { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); overflow: hidden; box-shadow: 0 16px 38px var(--panel-shadow); }
  .viewer-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px; border-bottom: 1px solid var(--line); background: var(--surface-soft); }
  .viewer-head span { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .viewport { position: relative; height: min(68vh, 660px); min-height: 460px; overflow: auto; background: var(--viewport-bg); scrollbar-gutter: stable; }
  .viewport-wrap { position: relative; }
  .scroll-hud { position: absolute; top: 10px; left: 50%; transform: translateX(-50%); z-index: 5; width: max-content; max-width: calc(100% - 28px); border: 1px solid rgba(102, 86, 217, 0.18); border-radius: 999px; padding: 8px 14px; color: var(--muted); background: var(--hud-bg); box-shadow: 0 10px 30px var(--hud-shadow); font-size: 13px; font-weight: 700; pointer-events: none; }
  .scroll-hud strong { color: var(--violet); font-variant-numeric: tabular-nums; }
  .scroll-hud.active { color: var(--primary-contrast); border-color: var(--violet); background: var(--violet); }
  .scroll-hud.active strong { color: var(--primary-contrast); }
  .spacer { width: 1px; opacity: 0; }
  .lab-virtual-card :global(.page-block) { position: absolute; top: 0; left: 0; right: 14px; padding: 16px; will-change: transform; }
  .lab-virtual-card :global(.page-inner) { display: grid; grid-template-rows: auto 1fr; gap: 12px; height: 100%; border: 1px solid var(--line); border-radius: var(--radius); padding: 14px; background: var(--page-bg); }
  .lab-virtual-card :global(.page-meta) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; color: var(--muted); font-size: 13px; }
  .lab-virtual-card :global(.page-start) { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; min-width: 0; }
  .lab-virtual-card :global(.page-start span) { color: var(--accent-strong); font-size: 12px; font-weight: 800; }
  .lab-virtual-card :global(.page-start strong) { color: var(--ink); font-size: 18px; font-variant-numeric: tabular-nums; }
  .lab-virtual-card :global(.card-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(3, minmax(0, 1fr)); gap: 12px; min-height: 0; }
  .lab-virtual-card :global(.data-card) { display: grid; grid-template-rows: auto 1fr auto; gap: 8px; min-width: 0; min-height: 0; border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: var(--radius); padding: 12px; background: var(--surface-card); box-shadow: 0 8px 22px var(--panel-shadow); }
  .lab-virtual-card :global(.data-card:nth-child(3n + 2)) { border-left-color: var(--violet); }
  .lab-virtual-card :global(.data-card:nth-child(3n)) { border-left-color: var(--amber); }
  .lab-virtual-card :global(.card-top), .lab-virtual-card :global(.card-bottom) { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-width: 0; }
  .lab-virtual-card :global(.card-index) { color: var(--accent-strong); font-size: 12px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .lab-virtual-card :global(.card-tag) { border-radius: 999px; padding: 4px 8px; color: var(--violet); background: var(--violet-soft); font-size: 11px; font-weight: 800; white-space: nowrap; }
  .lab-virtual-card :global(.card-title) { min-width: 0; margin: 0; overflow: hidden; color: var(--ink); font-size: 16px; line-height: 1.25; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
  .lab-virtual-card :global(.card-note) { display: -webkit-box; min-width: 0; overflow: hidden; margin: 4px 0 0; color: var(--muted); font-size: 12px; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .lab-virtual-card :global(.card-bottom) { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .lab-virtual-card :global(.card-bottom strong) { color: var(--ink); }
  .lab-virtual-card :global(.skeleton-line) { height: 12px; border-radius: 999px; background: linear-gradient(90deg, var(--skeleton-a) 0%, var(--skeleton-b) 45%, var(--skeleton-a) 100%); background-size: 220% 100%; animation: shimmer 1.2s linear infinite; }
  .lab-virtual-card :global(.skeleton-line.short) { width: 42%; }
  .lab-virtual-card :global(.skeleton-line.medium) { width: 70%; }
  @keyframes shimmer { from { background-position: 100% 0; } to { background-position: -100% 0; } }
  .side { padding: 14px; }
  .metric-grid { display: grid; gap: 10px; }
  .metric { border: 1px solid var(--line); border-radius: 10px; padding: 10px; background: var(--surface-card); }
  .metric-label { display: block; margin-bottom: 5px; color: var(--muted); font-size: 12px; line-height: 1.2; }
  .metric-value { display: block; font-size: 20px; line-height: 1.2; font-weight: 800; font-variant-numeric: tabular-nums; }
  .metric-value.small { font-size: 14px; color: var(--muted); word-break: break-all; }
  .chip-list { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 7px; min-height: 24px; }
  .lab-virtual-card :global(.chip) { display: inline-flex; align-items: center; height: 24px; border-radius: 999px; padding: 0 8px; background: var(--success-soft); color: var(--accent-strong); font-size: 12px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .lab-virtual-card :global(.chip.pending) { background: var(--amber-soft); color: var(--amber); }
  .notice { min-height: 18px; margin: 0; color: var(--red); font-size: 13px; line-height: 1.45; }
  @media (max-width: 900px) { .lab-hero, .main-grid { display: grid; grid-template-columns: 1fr; } .control-bar, .live-strip { grid-template-columns: 1fr; } .button-row { width: 100%; } .compact { justify-content: flex-start; } }
  @media (max-width: 700px) { .lab-virtual-card { width: min(100vw - 20px, 1180px); padding-top: 20px; } .card-grid { grid-template-columns: 1fr; grid-template-rows: repeat(6, minmax(0, 1fr)); } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: 0.01ms !important; } }
</style>

<script>
  const root = document.querySelector('[data-virtual-card-lab]');
  if (root) {
    const nf = new Intl.NumberFormat('zh-CN');
    const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
    const toPositiveInteger = (value, fallback = 1) => {
      const next = Number.parseInt(String(value), 10);
      return Number.isFinite(next) ? next : fallback;
    };
    const format = (value) => nf.format(value);
    const tags = ['实验', '虚拟滚动', '缓存', '分页', '性能', 'Mock'];

    const els = {
      viewport: root.querySelector('[data-viewport]'),
      spacer: root.querySelector('[data-spacer]'),
      pages: root.querySelector('[data-pages]'),
      rangePage: root.querySelector('[data-range-page]'),
      totalPagesInput: root.querySelector('[data-total-pages]'),
      jumpPageInput: root.querySelector('[data-jump-page]'),
      jumpLast: root.querySelector('[data-jump-last]'),
      currentPage: root.querySelector('[data-current-page]'),
      totalLabel: root.querySelector('[data-total-label]'),
      dragStatus: root.querySelector('[data-drag-status]'),
      loadPolicy: root.querySelector('[data-load-policy]'),
      wheelStatus: root.querySelector('[data-wheel-status]'),
      rangeLabel: root.querySelector('[data-range-label]'),
      hud: root.querySelector('[data-hud]'),
      totalCards: root.querySelector('[data-total-cards]'),
      cachedPages: root.querySelector('[data-cached-pages]'),
      pendingPages: root.querySelector('[data-pending-pages]'),
      lastRequest: root.querySelector('[data-last-request]'),
      notice: root.querySelector('[data-notice]'),
    };

    const state = {
      totalPages: 1000,
      pageSize: 6,
      pageHeight: window.innerWidth <= 700 ? 850 : 540,
      scrollTop: 0,
      viewportHeight: 0,
      currentPage: 1,
      isDragging: false,
      lastLoadTarget: 1,
      maxCachedPages: 24,
      requestEpoch: 0,
      cache: new Map(),
      pending: new Map(),
      controllers: new Map(),
      notice: '',
      lastRequestText: '等待首次加载',
      lastWheelJumpPages: 0,
      wheelDelta: 0,
      wheelStartAt: 0,
      wheelLastAt: 0,
      timers: {},
    };

    function totalCards() { return state.totalPages * state.pageSize; }
    function virtualHeight() { return state.totalPages * state.pageHeight; }
    function scrollSpacerHeight() { return virtualHeight() + Math.max(0, state.viewportHeight - state.pageHeight); }
    function pageFromScroll(value) {
      const lastPageTop = Math.max(0, (state.totalPages - 1) * state.pageHeight);
      if (value >= lastPageTop - 1) return state.totalPages;
      return clamp(Math.floor(value / state.pageHeight) + 1, 1, state.totalPages);
    }
    function visiblePages() {
      const first = pageFromScroll(Math.max(0, state.scrollTop - state.pageHeight));
      const last = pageFromScroll(state.scrollTop + state.viewportHeight + state.pageHeight);
      return Array.from({ length: last - first + 1 }, (_, index) => first + index);
    }
    function mockFetchCards({ page, pageSize, signal }) {
      const delay = 160 + ((page * 37) % 420);
      return new Promise((resolve, reject) => {
        const timer = window.setTimeout(() => {
          const cards = Array.from({ length: pageSize }, (_, index) => {
            const globalIndex = (page - 1) * pageSize + index + 1;
            return {
              id: `card-${globalIndex}`,
              index: globalIndex,
              tag: tags[globalIndex % tags.length],
              title: `虚拟卡片 #${format(globalIndex)}`,
              note: `来自第 ${format(page)} 页的模拟数据。停稳后只加载当前页附近，快速拖动时会中止远端请求。`,
              score: 60 + (globalIndex % 41),
              owner: `Lab-${String((globalIndex % 9) + 1).padStart(2, '0')}`,
            };
          });
          resolve({ cards, delay });
        }, delay);
        signal?.addEventListener('abort', () => {
          window.clearTimeout(timer);
          reject(new DOMException('Request aborted', 'AbortError'));
        });
      });
    }
    function refreshViewportHeight() { state.viewportHeight = els.viewport.clientHeight || 0; }
    function markDragging() {
      state.isDragging = true;
      window.clearTimeout(state.timers.drag);
      window.clearTimeout(state.timers.load);
      renderStatus();
    }
    function scheduleSettledLoad(delay) {
      window.clearTimeout(state.timers.drag);
      window.clearTimeout(state.timers.load);
      state.timers.drag = window.setTimeout(() => { state.isDragging = false; renderStatus(); }, delay);
      state.timers.load = window.setTimeout(() => {
        state.isDragging = false;
        scrollToPage(state.currentPage, false);
      }, delay + 40);
    }
    function scrollToPage(page, keepDragging = false) {
      const targetPage = clamp(toPositiveInteger(page, 1), 1, state.totalPages);
      const targetTop = Math.max(0, Math.min((targetPage - 1) * state.pageHeight, scrollSpacerHeight() - state.viewportHeight));
      state.scrollTop = targetTop;
      state.currentPage = targetPage;
      els.viewport.scrollTop = targetTop;
      els.rangePage.value = String(targetPage);
      els.jumpPageInput.value = String(targetPage);
      if (keepDragging) {
        markDragging();
        scheduleSettledLoad(220);
      } else {
        state.isDragging = false;
        loadPageWindow(targetPage, 1);
      }
      render();
    }
    function handleScroll() {
      state.scrollTop = els.viewport.scrollTop;
      state.currentPage = pageFromScroll(state.scrollTop);
      els.rangePage.value = String(state.currentPage);
      els.jumpPageInput.value = String(state.currentPage);
      markDragging();
      scheduleSettledLoad(220);
      render();
    }
    function nudgePage(delta) { scrollToPage(clamp(state.currentPage + delta, 1, state.totalPages), false); }
    function maxScrollTop() {
      return Math.max(0, scrollSpacerHeight() - state.viewportHeight);
    }
    function handleNativeScrollbarPointerDown(event) {
      if (event.button !== 0) return;
      const scrollbarWidth = els.viewport.offsetWidth - els.viewport.clientWidth;
      if (scrollbarWidth <= 0) return;
      const rect = els.viewport.getBoundingClientRect();
      const isVerticalScrollbar = event.clientX >= rect.right - scrollbarWidth && event.clientX <= rect.right;
      if (!isVerticalScrollbar) return;

      const maxTop = maxScrollTop();
      if (maxTop <= 0) return;

      const viewportHeight = els.viewport.clientHeight;
      const scrollHeight = Math.max(1, els.viewport.scrollHeight);
      const thumbHeight = clamp((viewportHeight / scrollHeight) * viewportHeight, 24, viewportHeight);
      const thumbTravel = Math.max(1, viewportHeight - thumbHeight);
      const thumbTop = (els.viewport.scrollTop / maxTop) * thumbTravel;
      const y = clamp(event.clientY - rect.top, 0, viewportHeight);
      const clickedOnNativeThumb = y >= thumbTop && y <= thumbTop + thumbHeight;

      // 保留拖动原生滑块的默认行为；只把点击轨道改成“按位置直接跳转”。
      if (clickedOnNativeThumb) return;

      event.preventDefault();
      event.stopPropagation();
      const ratio = clamp(y / viewportHeight, 0, 1);
      const targetPage = pageFromScroll(ratio * maxTop);
      scrollToPage(targetPage, false);
    }
    function handleWheel(event) {
      const now = performance.now();
      const directionChanged = Math.sign(state.wheelDelta) !== Math.sign(event.deltaY);
      if (!state.wheelStartAt || now - state.wheelLastAt > 140 || directionChanged) {
        state.wheelDelta = 0;
        state.wheelStartAt = now;
      }
      state.wheelDelta += event.deltaY;
      state.wheelLastAt = now;
      window.clearTimeout(state.timers.wheel);
      state.timers.wheel = window.setTimeout(flushWheelJump, 70);
    }
    function flushWheelJump() {
      if (!state.wheelDelta) return;
      const direction = state.wheelDelta > 0 ? 1 : -1;
      const duration = Math.max(80, state.wheelLastAt - state.wheelStartAt);
      const distance = Math.abs(state.wheelDelta);
      const speed = distance / duration;
      const distancePages = Math.max(1, Math.ceil(distance / 180));
      const speedMultiplier = speed >= 12 ? 4 : speed >= 6 ? 3 : speed >= 2.5 ? 2 : 1;
      const pageStep = clamp(distancePages * speedMultiplier, 1, 40);
      const targetPage = clamp(state.currentPage + direction * pageStep, 1, state.totalPages);
      state.lastWheelJumpPages = Math.abs(targetPage - state.currentPage);
      state.wheelDelta = 0;
      state.wheelStartAt = 0;
      state.wheelLastAt = 0;
      if (targetPage !== state.currentPage) scrollToPage(targetPage, false);
      renderStatus();
    }
    function syncTotalPageControls() {
      const total = String(state.totalPages);
      els.totalPagesInput.value = total;
      els.rangePage.max = total;
      els.jumpPageInput.max = total;
      if (els.jumpLast) {
        els.jumpLast.dataset.jump = total;
        els.jumpLast.textContent = '最后一页';
      }
    }
    function applyTotalPages() {
      const nextTotal = clamp(toPositiveInteger(els.totalPagesInput.value, state.totalPages), 1, 100000);
      abortAllRequests();
      state.totalPages = nextTotal;
      state.requestEpoch += 1;
      state.cache.clear();
      state.pending.clear();
      state.notice = '';
      state.lastRequestText = '等待首次加载';
      syncTotalPageControls();
      refreshViewportHeight();
      const nextPage = clamp(state.currentPage, 1, state.totalPages);
      state.currentPage = nextPage;
      state.scrollTop = Math.max(0, (nextPage - 1) * state.pageHeight);
      render();
      window.requestAnimationFrame(() => scrollToPage(nextPage, false));
    }
    function clearCache() {
      abortAllRequests();
      state.requestEpoch += 1;
      state.cache.clear();
      state.pending.clear();
      state.notice = '';
      state.lastRequestText = '等待首次加载';
      loadPageWindow(state.currentPage, 1);
      render();
    }
    function loadPageWindow(centerPage, radius = 1) {
      const targetPage = clamp(centerPage, 1, state.totalPages);
      const pages = new Set();
      state.lastLoadTarget = targetPage;
      for (let page = targetPage - radius; page <= targetPage + radius; page += 1) {
        if (page >= 1 && page <= state.totalPages) pages.add(page);
      }
      abortRequestsOutside(pages);
      pages.forEach(requestPage);
      trimCache(targetPage);
      renderStatus();
    }
    function requestPage(page) {
      if (page < 1 || page > state.totalPages || state.cache.has(page) || state.pending.has(page)) return;
      const epoch = state.requestEpoch;
      const controller = new AbortController();
      state.controllers.set(page, controller);
      state.pending.set(page, true);
      renderStatus();
      mockFetchCards({ page, pageSize: state.pageSize, signal: controller.signal })
        .then((result) => {
          if (epoch !== state.requestEpoch || controller.signal.aborted) return;
          state.cache.set(page, result.cards);
          state.lastRequestText = `page=${format(page)}, ${result.delay}ms`;
          trimCache(state.currentPage);
          render();
        })
        .catch((error) => {
          if (error?.name === 'AbortError') return;
          state.notice = `mockFetchCards(page=${page}) 失败: ${error?.message || String(error)}`;
        })
        .finally(() => {
          if (state.controllers.get(page) === controller) state.controllers.delete(page);
          state.pending.delete(page);
          renderStatus();
        });
    }
    function abortRequestsOutside(keepPages) {
      for (const [page, controller] of state.controllers.entries()) {
        if (!keepPages.has(page)) {
          controller.abort();
          state.controllers.delete(page);
          state.pending.delete(page);
        }
      }
    }
    function abortAllRequests() {
      for (const controller of state.controllers.values()) controller.abort();
      state.controllers.clear();
      state.pending.clear();
    }
    function trimCache(anchorPage) {
      const pages = Array.from(state.cache.keys());
      if (pages.length <= state.maxCachedPages) return;
      const keep = new Set(pages.sort((a, b) => Math.abs(a - anchorPage) - Math.abs(b - anchorPage)).slice(0, state.maxCachedPages));
      pages.forEach((page) => { if (!keep.has(page)) state.cache.delete(page); });
    }
    function renderPages() {
      const pages = visiblePages();
      els.spacer.style.height = `${scrollSpacerHeight()}px`;
      els.pages.innerHTML = pages.map((page) => renderPage(page)).join('');
    }
    function renderPage(page) {
      const cards = state.cache.get(page);
      const isPending = state.pending.has(page);
      const first = (page - 1) * state.pageSize + 1;
      const last = Math.min(first + state.pageSize - 1, totalCards());
      const body = cards ? cards.map(renderCard).join('') : Array.from({ length: state.pageSize }, (_, i) => renderSkeleton(i, isPending)).join('');
      return `<article class="page-block" style="height:${state.pageHeight}px; transform: translateY(${(page - 1) * state.pageHeight}px)"><div class="page-inner"><div class="page-meta"><div class="page-start"><span>PAGE ${format(page)}</span><strong>卡片 ${format(first)} - ${format(last)}</strong></div><span>${cards ? '已缓存' : isPending ? '请求中' : '待加载'}</span></div><div class="card-grid">${body}</div></div></article>`;
    }
    function renderCard(card) {
      return `<article class="data-card"><div class="card-top"><span class="card-index">#${format(card.index)}</span><span class="card-tag">${card.tag}</span></div><div><h3 class="card-title">${card.title}</h3><p class="card-note">${card.note}</p></div><div class="card-bottom"><span>${card.owner}</span><strong>${card.score}</strong></div></article>`;
    }
    function renderSkeleton(index, isPending) {
      return `<article class="data-card" aria-busy="${isPending}"><div class="card-top"><span class="skeleton-line short"></span><span class="card-tag">${isPending ? '加载中' : '空缓存'}</span></div><div><p class="skeleton-line medium"></p><p class="skeleton-line"></p></div><div class="card-bottom"><span class="skeleton-line short"></span><strong>${index + 1}</strong></div></article>`;
    }
    function renderChipList(target, pages, pending = false) {
      target.innerHTML = pages.length ? pages.slice(0, 18).map((page) => `<span class="chip ${pending ? 'pending' : ''}">${format(page)}</span>`).join('') : '<span class="chip">无</span>';
    }
    function renderStatus() {
      const first = (state.currentPage - 1) * state.pageSize + 1;
      const last = Math.min(first + state.pageSize - 1, totalCards());
      const maxScroll = Math.max(1, scrollSpacerHeight() - state.viewportHeight);
      const progress = clamp((state.scrollTop / maxScroll) * 100, 0, 100).toFixed(2);
      els.currentPage.textContent = format(state.currentPage);
      els.totalLabel.textContent = `/ ${format(state.totalPages)} 页`;
      els.rangeLabel.textContent = `卡片 ${format(first)} - ${format(last)} · 进度 ${progress}%`;
      els.totalCards.textContent = format(totalCards());
      els.dragStatus.textContent = state.isDragging ? '拖动中' : '停稳';
      els.dragStatus.classList.toggle('active', state.isDragging);
      els.loadPolicy.textContent = state.isDragging ? '停稳吸附页开头' : `加载第 ${format(state.lastLoadTarget)} 页附近`;
      els.wheelStatus.textContent = state.lastWheelJumpPages ? `滚轮跳 ${format(state.lastWheelJumpPages)} 页` : '滚轮按速度跳页';
      els.hud.innerHTML = `正在浏览 <strong>第 ${format(state.currentPage)} 页</strong>`;
      els.hud.classList.toggle('active', state.isDragging);
      els.lastRequest.textContent = state.lastRequestText;
      els.notice.textContent = state.notice;
      renderChipList(els.cachedPages, Array.from(state.cache.keys()).sort((a, b) => a - b));
      renderChipList(els.pendingPages, Array.from(state.pending.keys()).sort((a, b) => a - b), true);
    }
    function render() { renderPages(); renderStatus(); }
    function handleResize() {
      const page = state.currentPage;
      window.clearTimeout(state.timers.resize);
      state.timers.resize = window.setTimeout(() => {
        state.pageHeight = window.innerWidth <= 700 ? 850 : 540;
        refreshViewportHeight();
        scrollToPage(page, false);
      }, 80);
    }

    els.viewport.addEventListener('pointerdown', handleNativeScrollbarPointerDown, { capture: true });
    els.viewport.addEventListener('scroll', handleScroll, { passive: true });
    els.viewport.addEventListener('wheel', handleWheel, { passive: true });
    els.rangePage.addEventListener('input', (event) => scrollToPage(event.target.value, true));
    els.totalPagesInput.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') applyTotalPages();
    });
    root.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest('button') : null;
      if (!target || !root.contains(target)) return;
      if (target.matches('[data-apply-total]')) applyTotalPages();
      else if (target.matches('[data-jump-input]')) scrollToPage(els.jumpPageInput.value, false);
      else if (target.matches('[data-clear-cache]')) clearCache();
      else if (target.matches('[data-jump-last]')) scrollToPage(state.totalPages, false);
      else if (target.matches('[data-jump]')) scrollToPage(target.dataset.jump, false);
      else if (target.matches('[data-nudge]')) nudgePage(Number(target.dataset.nudge));
    });
    window.addEventListener('resize', handleResize);

    refreshViewportHeight();
    syncTotalPageControls();
    loadPageWindow(state.currentPage, 1);
    render();
  }
</script>
