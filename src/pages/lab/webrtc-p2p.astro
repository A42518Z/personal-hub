---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'WebRTC P2P 连接实验',
  description: '在同一页面中模拟两个 RTCPeerConnection，通过 DataChannel 完成点对点消息通信。',
};
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-6xl space-y-8 px-4 py-10 sm:px-6 lg:px-8">
    <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="grid gap-8 p-6 lg:grid-cols-[1fr_1fr] lg:p-8">
        <div class="space-y-5">
          <a href="/lab" class="text-sm font-semibold text-cyan-700 hover:text-cyan-600 dark:text-cyan-300">← 返回实验室</a>
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.28em] text-cyan-600 dark:text-cyan-300">WebRTC</p>
            <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl">P2P 点对点连接</h1>
            <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-300">
              使用两个 <code>RTCPeerConnection</code> 在本页内模拟本地端和远端，完成 offer / answer、ICE 候选交换，并通过 DataChannel 发送消息。
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <button id="createConnection" class="rounded-full bg-cyan-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-cyan-500">创建 P2P 连接</button>
            <button id="closeConnection" disabled class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-45 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">关闭连接</button>
          </div>
          <p id="p2pStatus" class="rounded-2xl bg-slate-100 px-4 py-3 text-sm text-slate-700 dark:bg-slate-800 dark:text-slate-200">点击“创建 P2P 连接”开始本地模拟。</p>
        </div>

        <div class="rounded-[1.5rem] border border-slate-200 bg-slate-950 p-5 text-cyan-50 dark:border-slate-700">
          <h2 class="text-lg font-bold">连接状态</h2>
          <dl class="mt-5 grid gap-4 text-sm">
            <div class="rounded-2xl bg-white/10 p-4">
              <dt class="text-cyan-200">Local Peer</dt>
              <dd id="localState" class="mt-1 font-semibold">未创建</dd>
            </div>
            <div class="rounded-2xl bg-white/10 p-4">
              <dt class="text-cyan-200">Remote Peer</dt>
              <dd id="remoteState" class="mt-1 font-semibold">未创建</dd>
            </div>
            <div class="rounded-2xl bg-white/10 p-4">
              <dt class="text-cyan-200">DataChannel</dt>
              <dd id="channelState" class="mt-1 font-semibold">未打开</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-xl font-bold text-slate-950 dark:text-white">发送消息</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">连接建立后，消息会从 Local Peer 通过 DataChannel 发送到 Remote Peer。</p>
        <label class="mt-5 block text-sm font-semibold text-slate-700 dark:text-slate-200" for="messageInput">消息内容</label>
        <textarea id="messageInput" rows="5" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-800 outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" placeholder="输入一条 P2P 消息">Hello WebRTC P2P!</textarea>
        <button id="sendMessage" disabled class="mt-4 rounded-full bg-slate-950 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-45 dark:bg-white dark:text-slate-950">发送到远端</button>
      </div>

      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-xl font-bold text-slate-950 dark:text-white">通信日志</h2>
        <div id="messageLog" class="mt-4 h-80 overflow-auto rounded-2xl bg-slate-950 p-4 font-mono text-sm leading-6 text-cyan-50">
          <p class="text-slate-400">等待创建连接……</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  const createButton = document.querySelector('#createConnection');
  const closeButton = document.querySelector('#closeConnection');
  const sendButton = document.querySelector('#sendMessage');
  const messageInput = document.querySelector('#messageInput');
  const status = document.querySelector('#p2pStatus');
  const localState = document.querySelector('#localState');
  const remoteState = document.querySelector('#remoteState');
  const channelState = document.querySelector('#channelState');
  const messageLog = document.querySelector('#messageLog');

  let localPeer;
  let remotePeer;
  let sendChannel;
  let receiveChannel;

  const log = (message, tone = 'text-cyan-50') => {
    const line = document.createElement('p');
    line.className = tone;
    line.textContent = `[${new Date().toLocaleTimeString()}] ${message}`;
    if (messageLog.querySelector('.text-slate-400')) messageLog.innerHTML = '';
    messageLog.append(line);
    messageLog.scrollTop = messageLog.scrollHeight;
  };

  const setStatus = (message) => {
    status.textContent = message;
  };

  const updateStates = () => {
    localState.textContent = localPeer ? `${localPeer.connectionState} / ICE: ${localPeer.iceConnectionState}` : '未创建';
    remoteState.textContent = remotePeer ? `${remotePeer.connectionState} / ICE: ${remotePeer.iceConnectionState}` : '未创建';
    channelState.textContent = sendChannel ? sendChannel.readyState : '未打开';
    sendButton.disabled = sendChannel?.readyState !== 'open';
  };

  const closeConnection = () => {
    sendChannel?.close();
    receiveChannel?.close();
    localPeer?.close();
    remotePeer?.close();
    sendChannel = undefined;
    receiveChannel = undefined;
    localPeer = undefined;
    remotePeer = undefined;
    createButton.disabled = false;
    closeButton.disabled = true;
    sendButton.disabled = true;
    updateStates();
    setStatus('P2P 连接已关闭。');
    log('连接已关闭。', 'text-amber-200');
  };

  createButton.addEventListener('click', async () => {
    if (!window.RTCPeerConnection) {
      setStatus('当前浏览器不支持 RTCPeerConnection，请使用最新版 Chrome、Edge、Firefox 或 Safari。');
      return;
    }

    closeConnection();
    messageLog.innerHTML = '';

    try {
      localPeer = new RTCPeerConnection();
      remotePeer = new RTCPeerConnection();
      sendChannel = localPeer.createDataChannel('chat');

      localPeer.addEventListener('icecandidate', (event) => {
        if (event.candidate) remotePeer.addIceCandidate(event.candidate);
      });
      remotePeer.addEventListener('icecandidate', (event) => {
        if (event.candidate) localPeer.addIceCandidate(event.candidate);
      });

      localPeer.addEventListener('connectionstatechange', updateStates);
      remotePeer.addEventListener('connectionstatechange', updateStates);
      localPeer.addEventListener('iceconnectionstatechange', updateStates);
      remotePeer.addEventListener('iceconnectionstatechange', updateStates);

      sendChannel.addEventListener('open', () => {
        createButton.disabled = true;
        closeButton.disabled = false;
        updateStates();
        setStatus('P2P DataChannel 已打开，可以发送消息。');
        log('DataChannel 已打开。', 'text-emerald-200');
      });
      sendChannel.addEventListener('close', updateStates);

      remotePeer.addEventListener('datachannel', (event) => {
        receiveChannel = event.channel;
        receiveChannel.addEventListener('message', (messageEvent) => {
          log(`Remote 收到：${messageEvent.data}`, 'text-cyan-100');
        });
      });

      const offer = await localPeer.createOffer();
      await localPeer.setLocalDescription(offer);
      await remotePeer.setRemoteDescription(offer);
      log('Local 创建 offer，并设置到 Remote。');

      const answer = await remotePeer.createAnswer();
      await remotePeer.setLocalDescription(answer);
      await localPeer.setRemoteDescription(answer);
      log('Remote 创建 answer，并设置回 Local。');

      closeButton.disabled = false;
      updateStates();
      setStatus('P2P 协商完成，等待 DataChannel 打开。');
    } catch (error) {
      setStatus(`P2P 连接创建失败：${error instanceof Error ? error.message : '未知错误'}`);
      log('连接创建失败，请查看浏览器控制台。', 'text-rose-200');
      closeConnection();
    }
  });

  sendButton.addEventListener('click', () => {
    const message = messageInput.value.trim();
    if (!message || sendChannel?.readyState !== 'open') return;
    sendChannel.send(message);
    log(`Local 发送：${message}`, 'text-white');
  });

  closeButton.addEventListener('click', closeConnection);
  window.addEventListener('pagehide', closeConnection);
</script>
