---
import Layout from '~/layouts/PageLayout.astro';
import HubHero from '~/components/hub/HubHero.astro';
import Reveal from '~/components/effects/Reveal.astro';
import BookmarkExplorer from '~/components/bookmark/BookmarkExplorer.astro';
import { bookmarkGroups } from '~/data/bookmarks';

const metadata = {
  title: '导航',
  description: '按场景整理常用网站、AI 工具、前端文档、设计灵感、组件库和 3D 参考。',
};
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-7xl space-y-12 px-4 py-10 sm:px-6 lg:px-8">
    <Reveal>
      <HubHero
        eyebrow="Bookmarks"
        title="把高频网站按场景整理成导航。"
        description="支持按分类筛选和关键词搜索，适合快速定位 AI 工具、前端文档、设计灵感、组件库、3D 参考和主题参考。"
      />
    </Reveal>

    <Reveal delay={100}>
      <BookmarkExplorer groups={bookmarkGroups} />
    </Reveal>
  </div>
</Layout>
